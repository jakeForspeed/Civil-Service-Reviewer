                            "question":"What is 20% of 150?",
                            "options":[
                                "20",
                                "25",
                                "30",
                                "35"
                            ],  
                            "correctAnswer":"30",
                            "explanation":"To find 20% of 150, multiply 150 by 0.20: 150 * 0.20 = 30."
                        },
                        {
                            "id":"NEP-002",
                            "difficulty":"medium",   
                            "question":"If a product originally costs $200 and is on sale for 25% off, what is the sale price?",
                            "options":[
                                "$150",
                                "$160",
                                "$170",
                                "$180"
                            ],  
                            "correctAnswer":"$150",
                            "explanation":"To find the sale price, calculate 25% of $200: 200 * 0.25 = $50. Subtract this from the original price: 200 - 50 = $150."
                        }
                    ]
                }
            ]
