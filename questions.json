                    "questions":[
                        {
                            "id":"VAG-001",
                            "difficulty":"easy",
                            "question":"Identify the correct sentence.",
                            "options":[
                                "She don't like ice cream.",
                                "She doesn't likes ice cream.",
                                "She doesn't like ice cream.",
                                "She don't likes ice cream."
                            ],  
                            "correctAnswer":"She doesn't like ice cream.",
                            "explanation":"The correct form is 'She doesn't like ice cream.' because 'doesn't' is the contraction of 'does not', and it should be followed by the base form of the verb, which is 'like'."
                        },
                        {
                            "id":"VAG-002",
                            "difficulty":"medium",
                            "question":"Choose the sentence that uses the correct form of the verb.",
                            "options":[
                                "He go to school every day.",
                                "He goes to school every day.",
                                "He going to school every day.",
                                "He gone to school every day."
                            ],  
                            "correctAnswer":"He goes to school every day.",
                            "explanation":"The correct form is 'He goes to school every day.' because 'goes' is the third person singular present tense of the verb 'go'."
                        }
                    ]
                }
            ]
            
