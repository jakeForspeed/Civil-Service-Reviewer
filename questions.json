                            "id":"VAV-002",
                            "difficulty":"medium",
                            "question":"Select the word that is most opposite in meaning to 'Benevolent'.",
                            "options":[
                                "Kind",
                                "Generous",
                                "Malevolent",
                                "Charitable"
                            ],  
                            "correctAnswer":"Malevolent",
                            "explanation":"The word 'Benevolent' means well-meaning and kindly. The opposite of this is 'Malevolent', which means having or showing a wish to do evil to others."
